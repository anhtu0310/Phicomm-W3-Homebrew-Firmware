# Third-party SDK (MediaTek LinkIt) - get it from upstream, not this repo.
# Exception: our firmware app, linkit_sdk-master/project/mt2523_hdk/apps/w3_display/.
# Git can't re-include a file whose parent directory is ignored, so each level
# is ignored by its contents (dir/*) and the one path we keep is re-opened.
linkit_sdk-master/*
!linkit_sdk-master/project/
linkit_sdk-master/project/*
!linkit_sdk-master/project/mt2523_hdk/
linkit_sdk-master/project/mt2523_hdk/*
!linkit_sdk-master/project/mt2523_hdk/apps/
linkit_sdk-master/project/mt2523_hdk/apps/*
!linkit_sdk-master/project/mt2523_hdk/apps/w3_display/
linkit_sdk-master.zip
*.zip

# Third-party reference repos (cloned separately)
ref/

# Raw flash dumps: large, vendor firmware, device-specific data (MAC, calibration)
stock_fw/flash_4MB*.bin

# Downloaded GNSS assist data (regenerable)
epo/

# Python
__pycache__/
*.pyc
